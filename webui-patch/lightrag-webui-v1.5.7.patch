+import { useCallback } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useSettingsStore } from '@/stores/settings'
+import { cn } from '@/lib/utils'
+
+const LANGUAGES = [
+  { id: 'th', label: 'TH', name: 'ไทย' },
+  { id: 'en', label: 'EN', name: 'English' }
+] as const
+
+/** TH | EN switch of the knowledge-base layout (the only two UI languages of this build). */
+export default function LanguageSwitch({ className }: { className?: string }) {
+  const { t, i18n } = useTranslation()
+  const setLanguage = useSettingsStore.use.setLanguage()
+  const current = i18n.language === 'th' ? 'th' : 'en'
+
+  const choose = useCallback(
+    (id: 'th' | 'en') => {
+      i18n.changeLanguage(id)
+      setLanguage(id)
+    },
+    [i18n, setLanguage]
+  )
+
+  return (
+    <div role="group" aria-label={t('header.language')} className={cn('flex gap-1', className)}>
+      {LANGUAGES.map((l) => (
+        <button
+          key={l.id}
+          type="button"
+          lang={l.id}
+          title={l.name}
+          aria-label={`${l.label} (${l.name})`}
+          aria-pressed={current === l.id}
+          onClick={() => choose(l.id)}
+          className={cn(
+            'rounded-md border px-2.5 py-1 text-xs font-semibold transition-colors',
+            current === l.id
+              ? 'border-[#8B2332] bg-[#8B2332] text-white'
+              : 'border-border bg-background text-muted-foreground hover:bg-muted'
+          )}
+        >
+          {l.label}
+        </button>
+      ))}
+    </div>
+  )
+}
