diff --git a/lightrag_webui/src/features/kb/ConnectPanel.tsx b/lightrag_webui/src/features/kb/ConnectPanel.tsx
new file mode 100644
index 0000000..daaa7cc
--- /dev/null
+++ b/lightrag_webui/src/features/kb/ConnectPanel.tsx
@@ -0,0 +1,286 @@
+import { useCallback, useEffect, useMemo, useState, type ReactNode } from 'react'
+import { useTranslation } from 'react-i18next'
+import { CheckIcon, CopyIcon, ExternalLinkIcon } from 'lucide-react'
+import { backendBaseUrl } from '@/lib/constants'
+import { useSettingsStore } from '@/stores/settings'
+import { useBackendState } from '@/stores/state'
+import { cn } from '@/lib/utils'
+
+/** webui/kb-config.js (edited on the server, no rebuild): where the MCP server is reached. */
+interface KbConfig {
+  mcpUrl?: string | null
+  mcpPort?: number
+}
+declare global {
+  interface Window {
+    __KB_CONFIG__?: KbConfig
+  }
+}
+
+function mcpUrl(): string {
+  const cfg = window.__KB_CONFIG__ || {}
+  if (cfg.mcpUrl) return cfg.mcpUrl
+  return `${window.location.protocol}//${window.location.hostname}:${cfg.mcpPort || 8806}/mcp`
+}
+
+function restBase(): string {
+  return `${window.location.origin}${backendBaseUrl}`
+}
+
+function mask(key: string): string {
+  return key.length <= 8 ? '••••••••' : `${key.slice(0, 4)}${'•'.repeat(12)}${key.slice(-4)}`
+}
+
+function CopyButton({ text }: { text: string }) {
+  const { t } = useTranslation()
+  const [done, setDone] = useState(false)
+  const copy = useCallback(() => {
+    void navigator.clipboard?.writeText(text).then(() => {
+      setDone(true)
+      setTimeout(() => setDone(false), 1500)
+    })
+  }, [text])
+  return (
+    <button
+      type="button"
+      onClick={copy}
+      className="hover:bg-muted flex shrink-0 items-center gap-1 rounded-md border px-2 py-0.5 text-xs"
+    >
+      {done ? <CheckIcon className="size-3" aria-hidden="true" /> : <CopyIcon className="size-3" aria-hidden="true" />}
+      {done ? t('connect.copied') : t('connect.copy')}
+    </button>
+  )
+}
+
+function Label({ children }: { children: ReactNode }) {
+  return <div className="text-muted-foreground mt-4 mb-1 text-[0.7rem] font-semibold tracking-wide uppercase">{children}</div>
+}
+
+function Field({ value, copy }: { value: string; copy?: string }) {
+  return (
+    <div className="bg-muted/50 flex items-center gap-2 rounded-md border px-2 py-1.5">
+      <code className="min-w-0 flex-1 truncate text-xs" title={value}>{value}</code>
+      <CopyButton text={copy ?? value} />
+    </div>
+  )
+}
+
+function Code({ text }: { text: string }) {
+  return (
+    <div className="relative">
+      <pre className="bg-muted/50 max-h-64 overflow-auto rounded-md border p-2 pr-16 text-[0.7rem] leading-relaxed whitespace-pre">{text}</pre>
+      <div className="absolute top-1.5 right-1.5">
+        <CopyButton text={text} />
+      </div>
+    </div>
+  )
+}
+
+function Tabs<T extends string>({ items, value, onChange }: { items: { id: T; label: string }[]; value: T; onChange: (v: T) => void }) {
+  return (
+    <div role="tablist" className="flex flex-wrap gap-1">
+      {items.map((i) => (
+        <button
+          key={i.id}
+          type="button"
+          role="tab"
+          aria-selected={value === i.id}
+          onClick={() => onChange(i.id)}
+          className={cn(
+            'rounded-md border px-2 py-0.5 text-xs',
+            value === i.id ? 'border-[#8B2332] bg-[#8B2332] text-white' : 'hover:bg-muted'
+          )}
+        >
+          {i.label}
+        </button>
+      ))}
+    </div>
+  )
+}
+
+function Dot({ state, label }: { state: boolean | null; label: string }) {
+  const { t } = useTranslation()
+  const text = state === null ? t('connect.checking') : state ? t('connect.online') : t('connect.offline')
+  return (
+    <span className="flex items-center gap-1.5 text-xs" title={text}>
+      <span className={cn('size-2 rounded-full', state === null ? 'bg-gray-400' : state ? 'bg-emerald-500' : 'bg-red-500')} />
+      {label} · {text}
+    </span>
+  )
+}
+
+/** The MCP server answers its own /health; reachable is all that can be told across origins (no-cors). */
+function useMcpReachable(url: string): boolean | null {
+  const [ok, setOk] = useState<boolean | null>(null)
+  useEffect(() => {
+    let alive = true
+    const health = url.replace(/\/mcp\/?$/, '') + '/health'
+    const probe = () =>
+      fetch(health, { mode: 'no-cors', cache: 'no-store' })
+        .then(() => alive && setOk(true))
+        .catch(() => alive && setOk(false))
+    probe()
+    const id = setInterval(probe, 30000)
+    return () => {
+      alive = false
+      clearInterval(id)
+    }
+  }, [url])
+  return ok
+}
+
+const QUESTION = { th: 'สรุปเอกสารในคลังโดยย่อ', en: 'Summarize the documents in the knowledge base' }
+
+function restExamples(base: string, q: string): Record<string, string> {
+  const body = JSON.stringify({ query: q, mode: 'mix', include_references: true })
+  return {
+    'curl (bash)': `export LIGHTRAG_API_KEY='<API key>'
+
+curl -X POST "${base}/query" \\
+  -H "X-API-Key: $LIGHTRAG_API_KEY" \\
+  -H "Content-Type: application/json" \\
+  -d '${body}'`,
+    PowerShell: `$env:LIGHTRAG_API_KEY = '<API key>'
+
+$body = '${body}'
+Invoke-RestMethod -Method Post -Uri "${base}/query" \`
+  -Headers @{ "X-API-Key" = $env:LIGHTRAG_API_KEY } \`
+  -ContentType "application/json; charset=utf-8" \`
+  -Body ([System.Text.Encoding]::UTF8.GetBytes($body))`,
+    Python: `import os, requests
+
+r = requests.post(
+    "${base}/query",
+    headers={"X-API-Key": os.environ["LIGHTRAG_API_KEY"]},
+    json=${body.replace('true', 'True')},
+    timeout=300,
+)
+print(r.json()["response"])`,
+    JavaScript: `const r = await fetch("${base}/query", {
+  method: "POST",
+  headers: { "X-API-Key": process.env.LIGHTRAG_API_KEY, "Content-Type": "application/json" },
+  body: JSON.stringify(${body}),
+});
+console.log((await r.json()).response);`
+  }
+}
+
+function mcpExamples(url: string): Record<string, string> {
+  return {
+    'Hermes (config.yaml)': `mcp_servers:
+  lightrag:
+    url: ${url}
+    timeout: 180
+    # headers:
+    #   Authorization: Bearer <MCP_AUTH_TOKEN>`,
+    'Claude Code': `claude mcp add --transport http lightrag ${url}
+# with a token:
+# claude mcp add --transport http lightrag ${url} --header "Authorization: Bearer <MCP_AUTH_TOKEN>"`,
+    'JSON (Cursor, others)': JSON.stringify({ mcpServers: { lightrag: { url } } }, null, 2)
+  }
+}
+
+/**
+ * Left panel: how another system reaches this knowledge base - the MCP server (mcp-lightrag)
+ * for AI agents, or the LightRAG REST API for apps and scripts - with ready-to-copy examples.
+ */
+export default function ConnectPanel() {
+  const { t, i18n } = useTranslation()
+  const [channel, setChannel] = useState<'mcp' | 'rest'>('mcp')
+  const apiKey = useSettingsStore.use.apiKey()
+  const ragHealth = useBackendState.use.health()
+  const lang = i18n.language === 'th' ? 'th' : 'en'
+
+  const mcp = useMemo(mcpUrl, [])
+  const base = useMemo(restBase, [])
+  const mcpOk = useMcpReachable(mcp)
+  const rest = useMemo(() => restExamples(base, QUESTION[lang]), [base, lang])
+  const mcpEx = useMemo(() => mcpExamples(mcp), [mcp])
+  const [restLang, setRestLang] = useState(Object.keys(rest)[0])
+  const [mcpLang, setMcpLang] = useState(Object.keys(mcpEx)[0])
+
+  return (
+    <div className="flex h-full flex-col">
+      <div className="min-h-0 flex-1 overflow-y-auto px-3 pb-4">
+        <p className="text-muted-foreground mt-3 text-xs">{t('connect.intro')}</p>
+        <div className="mt-2">
+          <Tabs
+            items={[
+              { id: 'mcp', label: t('connect.mcpTab') },
+              { id: 'rest', label: t('connect.restTab') }
+            ]}
+            value={channel}
+            onChange={setChannel}
+          />
+        </div>
+
+        {channel === 'mcp' ? (
+          <>
+            <p className="mt-3 text-xs">{t('connect.mcpWhen')}</p>
+            <Label>{t('connect.endpoint')}</Label>
+            <Field value={mcp} />
+            <div className="text-muted-foreground mt-1 text-[0.7rem]">{t('connect.mcpTransport')}</div>
+            <Label>{t('connect.auth')}</Label>
+            <p className="text-xs">{t('connect.mcpAuth')}</p>
+            <Label>{t('connect.tools')}</Label>
+            <ul className="space-y-1 text-xs">
+              <li><code>lightrag_query</code> — {t('connect.toolQuery')}</li>
+              <li><code>lightrag_insert</code> — {t('connect.toolInsert')}</li>
+              <li><code>lightrag_list_documents</code> — {t('connect.toolList')}</li>
+              <li><code>lightrag_delete</code> — {t('connect.toolDelete')}</li>
+            </ul>
+            <Label>{t('connect.setup')}</Label>
+            <Tabs items={Object.keys(mcpEx).map((k) => ({ id: k, label: k }))} value={mcpLang} onChange={setMcpLang} />
+            <div className="mt-2">
+              <Code text={mcpEx[mcpLang]} />
+            </div>
+          </>
+        ) : (
+          <>
+            <p className="mt-3 text-xs">{t('connect.restWhen')}</p>
+            <Label>{t('connect.endpoint')}</Label>
+            <Field value={`${base}/query`} />
+            <div className="text-muted-foreground mt-1 text-[0.7rem]">POST · application/json</div>
+            <Label>{t('connect.key')}</Label>
+            {apiKey ? <Field value={mask(apiKey)} copy={apiKey} /> : <p className="text-xs">{t('connect.keyNone')}</p>}
+            <p className="text-muted-foreground mt-1 text-[0.7rem]">{t('connect.keyHint')}</p>
+            <Label>{t('connect.request')}</Label>
+            <Code
+              text={JSON.stringify(
+                {
+                  query: QUESTION[lang],
+                  mode: 'mix | hybrid | local | global | naive',
+                  include_references: true,
+                  conversation_history: [{ role: 'user', content: '…' }, { role: 'assistant', content: '…' }]
+                },
+                null,
+                2
+              )}
+            />
+            <Label>{t('connect.response')}</Label>
+            <Code text={JSON.stringify({ response: '…', references: [{ reference_id: '1', file_path: 'report.pdf' }] }, null, 2)} />
+            <p className="text-muted-foreground mt-1 text-[0.7rem]">{t('connect.stream')}</p>
+            <Label>{t('connect.examples')}</Label>
+            <Tabs items={Object.keys(rest).map((k) => ({ id: k, label: k }))} value={restLang} onChange={setRestLang} />
