+import { useCallback, useState, type ReactNode } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ChevronLeftIcon, ChevronRightIcon } from 'lucide-react'
+import { cn } from '@/lib/utils'
+
+interface SidePanelProps {
+  side: 'left' | 'right'
+  /** localStorage key that remembers whether the panel is open */
+  storageKey: string
+  title: string
+  icon: ReactNode
+  /** width when open, e.g. "w-[360px]" */
+  widthClass: string
+  children: ReactNode
+}
+
+function initialOpen(storageKey: string): boolean {
+  try {
+    const saved = localStorage.getItem(storageKey)
+    if (saved !== null) return saved === '1'
+  } catch {
+    /* private mode: fall through */
+  }
+  return typeof window === 'undefined' || window.innerWidth >= 1280
+}
+
+/**
+ * A side panel that folds into a narrow rail (title written vertically) and opens again
+ * with one click; the choice is remembered in this browser.
+ */
+export default function SidePanel({ side, storageKey, title, icon, widthClass, children }: SidePanelProps) {
+  const { t } = useTranslation()
+  const [open, setOpen] = useState(() => initialOpen(storageKey))
+
+  const toggle = useCallback(() => {
+    setOpen((o) => {
+      try {
+        localStorage.setItem(storageKey, o ? '0' : '1')
+      } catch {
+        /* ignore */
+      }
+      return !o
+    })
+  }, [storageKey])
+
+  const border = side === 'left' ? 'border-r' : 'border-l'
+  const FoldIcon = (side === 'left') === open ? ChevronLeftIcon : ChevronRightIcon
+
+  if (!open) {
+    return (
+      <aside className={cn('bg-muted/30 flex w-9 shrink-0 flex-col items-center', border)}>
+        <button
+          type="button"
+          onClick={toggle}
+          aria-expanded={false}
+          aria-label={t('panel.show', { name: title })}
+          title={t('panel.show', { name: title })}
+          className="hover:bg-muted flex w-full flex-1 flex-col items-center gap-3 py-3"
+        >
+          <FoldIcon className="size-4" aria-hidden="true" />
+          {icon}
+          <span className="text-muted-foreground text-xs font-semibold [writing-mode:vertical-rl]">{title}</span>
+        </button>
+      </aside>
+    )
+  }
+
+  return (
+    <aside className={cn('bg-background flex shrink-0 flex-col overflow-hidden', widthClass, border)}>
+      <div className="flex h-10 shrink-0 items-center justify-between gap-2 border-b px-3">
+        <span className="flex min-w-0 items-center gap-2 text-sm font-semibold">
+          {icon}
+          <span className="truncate">{title}</span>
+        </span>
+        <button
+          type="button"
+          onClick={toggle}
+          aria-expanded={true}
+          aria-label={t('panel.hide', { name: title })}
+          title={t('panel.hide', { name: title })}
+          className="hover:bg-muted rounded-md p-1"
+        >
+          <FoldIcon className="size-4" aria-hidden="true" />
+        </button>
+      </div>
+      <div className="min-h-0 flex-1">{children}</div>
+    </aside>
+  )
+}
