@@ -0,0 +1,102 @@
+import { useCallback, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import type { QueryMode } from '@/api/lightrag'
+import { useQuerySettingsStore } from '@/stores/querySettings'
+import { createRetrievalHistoryStore } from '@/stores/retrievalHistory'
+import { storageKey } from '@/lib/storageKeys'
+import MessageList from '@/features/retrieval/MessageList'
+import QueryComposer from '@/features/retrieval/QueryComposer'
+import { useQuerySession } from '@/features/retrieval/useQuerySession'
+import { prepareQueryInput, SUPPORTED_QUERY_MODES } from '@/features/retrieval/queryInput'
+import { cn } from '@/lib/utils'
+
+/** The side chat keeps its own conversation, apart from the Retrieval tab. */
+const useSideChatHistoryStore = createRetrievalHistoryStore(storageKey('kb-side-chat-history'))
+const MODES: QueryMode[] = ['mix', 'hybrid', 'local', 'global', 'naive']
+const MODE_KEY = 'kb-side-chat-mode'
+
+function savedMode(): QueryMode {
+  try {
+    const m = localStorage.getItem(MODE_KEY) as QueryMode | null
+    if (m && MODES.includes(m)) return m
+  } catch {
+    /* ignore */
+  }
+  return 'mix'
+}
+
+/**
+ * Right panel: ask the knowledge base from any tab. It reuses the query session, message
+ * list and composer of the Retrieval tab, with the other query settings of that tab and
+ * only the search mode chosen here.
+ */
+export default function SideChat() {
+  const { t } = useTranslation()
+  const [mode, setMode] = useState<QueryMode>(savedMode)
+
+  const getQuerySettingsSnapshot = useCallback(
+    () => ({ ...useQuerySettingsStore.getState().querySettings, mode }),
+    [mode]
+  )
+
+  const session = useQuerySession({ historyStore: useSideChatHistoryStore, getQuerySettingsSnapshot })
+
+  const handleSend = useCallback(
+    (input: string): string | null => {
+      const prepared = prepareQueryInput(input, mode)
+      if (!prepared.ok) {
+        return t(`retrievePanel.retrieval.${prepared.error}`, { modes: SUPPORTED_QUERY_MODES.join(', ') })
+      }
+      void session.submitQuery(prepared.query, { modeOverride: prepared.modeOverride, displayedInput: input })
+      return null
+    },
+    [mode, session, t]
+  )
+
+  const chooseMode = useCallback((m: QueryMode) => {
+    setMode(m)
+    try {
+      localStorage.setItem(MODE_KEY, m)
+    } catch {
+      /* ignore */
+    }
+  }, [])
+
+  return (
+    <div className="flex h-full flex-col gap-2 p-2">
+      <div className="flex shrink-0 flex-wrap items-center gap-1">
+        <span className="text-muted-foreground mr-1 text-xs">{t('sideChat.mode')}</span>
+        {MODES.map((m) => (
+          <button
+            key={m}
+            type="button"
+            aria-pressed={mode === m}
+            onClick={() => chooseMode(m)}
+            className={cn(
+              'rounded-md border px-2 py-0.5 font-mono text-xs',
+              mode === m ? 'border-[#8B2332] bg-[#8B2332] text-white' : 'hover:bg-muted'
+            )}
+          >
+            {m}
+          </button>
+        ))}
+      </div>
+      <div className="flex min-h-0 flex-1 flex-col gap-2 [&_textarea]:text-sm">
+        <MessageList
+          messages={session.messages}
+          isLoading={session.isLoading}
+          queryProgress={session.queryProgress}
+          isActive={true}
+          emptyState={<div className="text-muted-foreground px-4 text-center text-sm">{t('sideChat.empty')}</div>}
+        />
+        <QueryComposer
+          isLoading={session.isLoading}
+          stopDisabled={session.stopDisabled}
+          onSend={handleSend}
+          onStop={session.handleStop}
+          onClear={session.clearMessages}
+        />
+      </div>
+    </div>
+  )
+}
