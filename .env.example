# =============================================================================
# lightrag-knowledge-base — คลังความรู้ LightRAG พร้อมหน้าเว็บ และ MCP server สำหรับเอเจนต์ AI — ตัวอย่างไฟล์ .env
# ใช้ร่วมกันทั้ง LightRAG server (อ่านจาก /app/.env) และ mcp-lightrag
# -----------------------------------------------------------------------------
# ไฟล์นี้แบ่งเป็น 5 หมวดเช่นเดียวกับไฟล์ .env
# บรรทัดที่ไม่มี # นำหน้าคือค่าที่จำเป็นต้องกำหนดในไฟล์ .env
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d แล้ว docker compose restart lightrag
# (LightRAG อ่านไฟล์นี้ตอนเริ่มทำงานเท่านั้น)
# ค่าตั้งอื่นทั้งหมดของ LightRAG ดูได้ที่ https://github.com/HKUDS/LightRAG/blob/v1.5.7/env.example
# =============================================================================

# --- คลังความรู้ ---
# key ของ LightRAG (ค่าลับ) ทั้งหน้าเว็บ REST API และ mcp-lightrag ต้องใช้ key นี้ ห้ามเว้นว่าง
#   สร้างได้ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIGHTRAG_API_KEY=change-me-to-a-long-random-key
# ชื่อคลังที่แสดงต่อท้าย "คลังความรู้" มุมซ้ายบนของหน้าเว็บ และคำอธิบายเมื่อชี้เมาส์ (เว้นว่างได้)
# WEBUI_TITLE=
# WEBUI_DESCRIPTION=
# ภาษาที่ LightRAG ใช้สรุปเอนทิตีและความสัมพันธ์ในกราฟความรู้ เช่น Thai หรือ English
SUMMARY_LANGUAGE=Thai

# --- LLM และ embedding ---
# LightRAG เรียก LLM และ embedding ผ่านมิเตอร์ของ mcp-lightrag (http://mcp-lightrag:8700/meter)
# มิเตอร์ส่งทุกคำขอต่อไปยัง METER_UPSTREAM โดยไม่แก้ไข และบันทึก token ไว้ที่ GET /usage ของ mcp-lightrag
#   หากไม่ต้องการมิเตอร์ ให้ตั้ง LLM_BINDING_HOST และ EMBEDDING_BINDING_HOST เป็นที่อยู่ของผู้ให้บริการโดยตรง
LLM_BINDING=openai
LLM_BINDING_HOST=http://mcp-lightrag:8700/meter
# API key ของผู้ให้บริการ LLM (ค่าลับ) เช่น OpenRouter https://openrouter.ai/keys
LLM_BINDING_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# model ที่รองรับภาษาไทยได้ดี
LLM_MODEL=google/gemma-4-31b-it
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://mcp-lightrag:8700/meter
EMBEDDING_BINDING_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# ขนาดเวกเตอร์ของ embedding model ต้องตรงกับ model (เปลี่ยน model หลังเพิ่มเอกสารแล้ว ต้องล้าง data/rag_storage)
EMBEDDING_DIM=4096

# --- mcp-lightrag (MCP server และมิเตอร์) ---
# endpoint จริงของผู้ให้บริการ LLM ที่มิเตอร์ส่งต่อให้ (ต้องเป็นผู้ให้บริการเดียวกับ LLM_BINDING_API_KEY)
METER_UPSTREAM=https://openrouter.ai/api/v1
# อธิบายสั้น ๆ ว่าคลังเก็บเอกสารเรื่องอะไร ระบบจะใส่ในคำอธิบายเครื่องมือ เพื่อให้เอเจนต์รู้ว่าควรค้นคลังนี้เมื่อใด
# KB_DESCRIPTION=
# วิธีค้นหาที่ให้เอเจนต์เลือก และวิธีที่ใช้เมื่อเอเจนต์ไม่ได้ระบุ
# QUERY_MODES=mix,hybrid,local,global,naive
# DEFAULT_MODE=hybrid
# อนุญาตให้เอเจนต์เพิ่มหรือลบเอกสาร (การลบกู้คืนไม่ได้)
# ENABLE_INSERT=true
# ENABLE_DELETE=false
# หากกำหนด เอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง (ค่าลับ) แนะนำเมื่อเปิดพอร์ตให้เครื่องอื่นเข้าถึง
# MCP_AUTH_TOKEN=

# --- docker compose ---
# image ของ LightRAG (หน้าเว็บใน ./webui สร้างสำหรับ v1.5.7 หากเปลี่ยนเวอร์ชัน ต้องสร้างหน้าเว็บใหม่ ดู README)
# LIGHTRAG_IMAGE=ghcr.io/hkuds/lightrag:v1.5.7
# หน้าเว็บและ REST API: 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าถึงได้ · 127.0.0.1 = เฉพาะเครื่องนี้
# WEBUI_PUBLISH_ADDR=0.0.0.0
# WEBUI_PORT=9621
# MCP server สำหรับเอเจนต์ AI
# MCP_PUBLISH_ADDR=0.0.0.0
# MCP_PUBLISH_PORT=8806
# docker network ที่ใช้ร่วมกับเอเจนต์ (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
